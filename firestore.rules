rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || (request.auth.token.email == 'suporte@ebensystem.com.br' && request.auth.token.email_verified == true));
    }
    function owns(userId) { return signedIn() && userId == request.auth.uid; }
    function isHost() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'host';
    }
    function listingOwner(propertyId) {
      return get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerId', '');
    }
    function validProperty(data, propertyId) {
      return data.id == propertyId
        && data.title is string && data.title.size() > 0
        && data.city is string && data.city.size() > 0
        && data.state is string
        && data.price is number && data.price > 0
        && data.guests is int && data.guests > 0
        && data.images is list && data.images.size() > 0
        && data.unavailable is list;
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if validProperty(request.resource.data, propertyId)
        && (isAdmin() || (isHost() && request.resource.data.ownerId == request.auth.uid));
      allow update: if validProperty(request.resource.data, propertyId)
        && (isAdmin() || (isHost() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid));
      allow delete: if isAdmin() || (isHost() && resource.data.ownerId == request.auth.uid);
    }

    match /reservations/{reservationId} {
      allow read: if isAdmin() || owns(resource.data.get('userId', '')) || owns(resource.data.get('propertyOwnerId', ''));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == reservationId
        && (request.resource.data.status == 'pendente' || (request.resource.data.status == 'confirmada' && request.resource.data.get('source', '') == 'host' && (isAdmin() || owns(listingOwner(request.resource.data.propertyId)))))
        && request.resource.data.propertyId is string
        && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.active == true
        && request.resource.data.propertyOwnerId == listingOwner(request.resource.data.propertyId)
        && request.resource.data.guest is string
        && request.resource.data.checkIn is string
        && request.resource.data.checkOut is string
        && request.resource.data.total is number
        && request.resource.data.total > 0;
      allow update: if isAdmin()
        || (owns(resource.data.get('propertyOwnerId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'payments', 'occupancy', 'actualCheckIn', 'actualCheckOut'])
          && request.resource.data.status in ['confirmada', 'cancelada'])
        || (owns(resource.data.get('userId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelada');
      allow delete: if isAdmin();
    }

    match /availability/{lockId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.reservationId is string
        && existsAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.propertyId == request.resource.data.propertyId
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.status in ['pendente', 'confirmada']
        && request.resource.data.date >= getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.checkIn
        && request.resource.data.date < getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.checkOut;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn()
          && existsAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId))
          && getAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.status == 'cancelada'
          && (getAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.get('userId', '') == request.auth.uid
            || getAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.get('propertyOwnerId', '') == request.auth.uid));
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'accountType', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && (!request.resource.data.keys().hasAny(['accountType'])
          || request.resource.data.accountType in ['customer', 'host']);
      allow delete: if false;

      match /favorites/{propertyId} {
        allow read, write: if owns(userId);
      }
    }
  }
}
