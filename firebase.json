{
  "hosting": {
    "site": "ebenliving-52a3e",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "**/*.md",
      "**/*.txt",
      "**/*.log",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ps1",
      "firestore.rules",
      "**/.*/**",
      ".github-site-check/**",
      ".firebase/**",
      "**/test",
      "functions/**",
      "scripts/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "test-results/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "destination": "/",
        "source": "/index.html",
        "type": 301
      },
      {
        "destination": "/",
        "source": "/index",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "ebenliving",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        "*.test.cjs"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
